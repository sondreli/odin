;; shadow-cljs configuration
{:source-paths ["src"]

 :dependencies[[reagent "2.0.1"]
               [re-frame "1.4.4"]
               [cljs-ajax "0.8.4"]
               [com.cognitect/transit-cljs "0.8.280"]
               [bidi "2.1.6"]
               [kibu/pushy "0.3.8"]
               [com.cemerick/url "0.1.1"]
               [day8.re-frame/http-fx "0.2.4"]
               [org.clojure/core.async "1.3.610"]
               [com.taoensso/timbre "4.10.0"]]

 :dev-http {4000 "public/"}

 :builds {:app {:output-dir "public/js"
                :asset-path "/js"
                :target :browser
                :modules {:main {:init-fn client.core/main!}}
                :release {:closure-defines {client.api/API_BASE "/api"}}
                :devtools {:after-load client.core/reload!
                           :http-root "public"
                           :http-port 4000}}

          :mobile {:target :react-native
                   :init-fn client.mobile.core/init
                   :output-dir "mobile/Odin/cljs-out"
                   :compiler-options {:infer-externs :auto}
                   :release {:closure-defines {client.api/API_BASE "https://d2tmrmh08b6pvl.cloudfront.net/api"}}
                   :js-options {:resolve {"react-dom" {:target :global :global "null"}
                                          "d3"        {:target :global :global "null"}
                                          "choices.js" {:target :global :global "null"}}}}}



 }
